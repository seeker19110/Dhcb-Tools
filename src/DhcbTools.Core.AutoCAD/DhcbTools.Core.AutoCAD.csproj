<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>DhcbTools.Core.AutoCAD</RootNamespace>
    <AssemblyName>DhcbTools.Core.AutoCAD</AssemblyName>
    <!--
      AutoCAD 2024 trở về trước dùng .NET Framework 4.8.
      AutoCAD 2025+ dùng .NET 8.0-windows (tương tự Revit).
      Cùng quy ước với Revit trong Directory.Build.props.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- CommandCatalog (whitelist lệnh cho AI/MCP) dùng chung với Revit. -->
    <ProjectReference Include="..\DhcbTools.Shared.Logic\DhcbTools.Shared.Logic.csproj" />
    <!-- CommandResult dùng chung nằm ở Shared.Hosting (lỗi #9) — Core.AutoCAD không còn bản riêng. -->
    <ProjectReference Include="..\DhcbTools.Shared.Hosting\DhcbTools.Shared.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Global using để 20+ lệnh hiện có không phải đổi từng file. -->
    <Using Include="DhcbTools.Shared.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Package chính thức của Autodesk trên NuGet — đóng gói AcMgd/AcCoreMgd/AcDbMgd
      theo từng năm phát hành, không cần cài AutoCAD trên máy build.
      AutoCAD.NET  = meta-package kéo cả Core + Model + UI vào.
      Version "24.*" tương ứng AutoCAD 2024 (internal version 24.x).
      Revit dùng cách tương tự với Nice3point.Revit.Api.RevitAPI.
    -->
    <PackageReference Include="AutoCAD.NET" Version="$(AcadNetVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!--
      snapshot (10.1) trả System.Drawing.Bitmap: net48 có System.Drawing trong hộp, còn net8/net10 phải
      kéo System.Drawing.Common — AutoCAD.NET không khai dependency này dù AcDbMgd trả Bitmap.
      Không dùng "Reference" cho net8+ (không có assembly đó trong runtime pack) và không dùng package
      cho net48 (thừa, và kéo cả bộ phụ thuộc .NET Core vào add-in .NET Framework).
    -->
    <Reference Include="System.Drawing" Condition="'$(TargetFramework)'=='net48'" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.*" Condition="'$(TargetFramework)'=='net8.0-windows'" />
    <!-- AcDbMgd 25.1 (AutoCAD 2026, net10) tham chiếu System.Drawing.Common 10.0.0.0 — bản 8.0 gây CS1705. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.*" Condition="'$(TargetFramework)'=='net10.0-windows'" />
  </ItemGroup>

</Project>
