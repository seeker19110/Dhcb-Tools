<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>DhcbTools.Core.AutoCAD</RootNamespace>
    <AssemblyName>DhcbTools.Core.AutoCAD</AssemblyName>
    <!--
      Chỉ hỗ trợ .NET 10 (AutoCAD 2025/2026/2027); xem Directory.Build.props.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- CommandCatalog (whitelist lệnh cho AI/MCP) dùng chung với Revit. -->
    <ProjectReference Include="..\DhcbTools.Shared.Logic\DhcbTools.Shared.Logic.csproj" />
    <!-- CommandResult dùng chung nằm ở Shared.Hosting (lỗi #9) — Core.AutoCAD không còn bản riêng. -->
    <ProjectReference Include="..\DhcbTools.Shared.Hosting\DhcbTools.Shared.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Global using để 20+ lệnh hiện có không phải đổi từng file. -->
    <Using Include="DhcbTools.Shared.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Package chính thức của Autodesk trên NuGet — đóng gói AcMgd/AcCoreMgd/AcDbMgd
      theo từng năm phát hành, không cần cài AutoCAD trên máy build.
      AutoCAD.NET  = meta-package kéo cả Core + Model + UI vào.
      SDK được pin theo năm và runtime trong Directory.Build.props.
      Revit dùng cách tương tự với Nice3point.Revit.Api.RevitAPI.
    -->
    <PackageReference Include="AutoCAD.NET" Version="$(AcadNetVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!--
      snapshot (10.1) trả System.Drawing.Bitmap — AutoCAD.NET không khai dependency System.Drawing.Common dù AcDbMgd
      trả Bitmap, nên phải kéo package này (.NET 10 là profile duy nhất còn hỗ trợ).
    -->
    <!--
      AcDbMgd bản .NET 10 (AutoCAD 2025/2026 cập nhật hoặc 2027) tham chiếu System.Drawing.Common 10.0.0.0 — bản thấp hơn gây CS1705.
      NoWarn NU1510: SDK 10 báo "package tự động có sẵn, bỏ PackageReference đi", nhưng bỏ thật thì được
      CS1069 ("type Bitmap đã forward sang System.Drawing.Common, thêm reference đi") — đã thử. Gói này chỉ
      tự có khi project dùng WindowsDesktop.App (WinForms/WPF), mà vỏ core-only thì không.
    -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" Condition="'$(TargetFramework)'=='net10.0-windows'" />
  </ItemGroup>

  <!-- NU1510 là cảnh báo lúc restore nên phải tắt ở PropertyGroup, không tắt được trên PackageReference. -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows'">
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

</Project>
