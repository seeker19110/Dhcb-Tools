<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>DhcbTools.Core</RootNamespace>
    <AssemblyName>DhcbTools.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      RevitAPI.dll / RevitAPIUI.dll không có trên NuGet chính thức của Autodesk cho mọi bản;
      cách chuẩn là tham chiếu trực tiếp tới thư mục cài Revit trên máy build, ví dụ:
        %ProgramFiles%\Autodesk\Revit <version>\RevitAPI.dll
      Hoặc dùng package cộng đồng Nice3point.Revit.Api.RevitAPI (khuyến nghị cho CI).
      Core CHỈ tham chiếu RevitAPI (đọc/ghi Document), KHÔNG tham chiếu RevitAPIUI.
    -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DhcbTools.Shared.Logic\DhcbTools.Shared.Logic.csproj" />
    <ProjectReference Include="..\DhcbTools.Shared.Hosting\DhcbTools.Shared.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CommandResult dùng chung nằm ở Shared.Hosting; global using để code hiện có không phải đổi. -->
    <Using Include="DhcbTools.Shared.Hosting" />
    <!-- Polyfill init/required cho net48 — một file duy nhất, link từ Shared.Hosting (lỗi #9). -->
    <Compile Include="..\DhcbTools.Shared.Hosting\Polyfills.cs" Link="Polyfills.cs" Condition="'$(TargetFramework)'=='net48'" />
  </ItemGroup>

</Project>
