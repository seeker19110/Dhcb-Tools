<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console điều phối batch chạy đêm (Giai đoạn 1). KHÔNG tham chiếu Revit/AutoCAD:
      - Revit: ghi %APPDATA%\DHCB\pending-job.json + journal, mở Revit.exe; add-in DhcbTools.Revit tự chạy job rồi thoát.
      - AutoCAD: sinh script .scr, chạy accoreconsole.exe cho từng DWG (không cần UI).
    Sau đó đọc run.jsonl → báo cáo HTML + mã thoát (0/1/2) cho Task Scheduler.
    net10.0 thuần để build/test được trên CI Linux. Vì sao net10 chứ không net8: .NET 8 hết hỗ trợ
    10/11/2026, mà đây là thứ DUY NHẤT trong repo chạy bằng runtime .NET riêng trên máy khách (vỏ
    Revit/AutoCAD chạy trong runtime của phần mềm chủ). Nó không tham chiếu Revit/AutoCAD nên đổi được
    độc lập với ma trận phiên bản ở Directory.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DhcbTools.BatchRunner</RootNamespace>
    <AssemblyName>DhcbTools.BatchRunner</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      InvariantGlobalization phải là FALSE: ở chế độ invariant, string.Normalize() thành no-op, nên
      LayerMappingSuggester.RemoveDiacritics KHÔNG bỏ dấu nữa — mọi so khớp bỏ dấu của Shared.Logic gọi
      từ runner (đối chiếu danh mục hồ sơ 11.6, đọc ý định lệnh) âm thầm sai mà không có lỗi nào.
      Lộ ra khi chạy thử tham số dossier trên thư mục có file "Báo cáo khảo sát địa chất.pdf": mẫu *khao-sat*
      trượt trong exe nhưng khớp trong test thuần (test host không bật invariant) — §48.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DhcbTools.Shared.Logic\DhcbTools.Shared.Logic.csproj" />
  </ItemGroup>

</Project>
