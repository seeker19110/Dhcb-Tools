<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phần hạ tầng dùng chung giữa vỏ Revit và vỏ AutoCAD (mục 0.2 đặc tả tính năng, lỗi #9):
    CommandResult, ICoreCommand<TConfig, TDocument>, và HttpBridgeServer (vòng lặp HttpListener,
    phân giải route, xác thực token, timeout có cờ Abandoned). KHÔNG tham chiếu Revit/AutoCAD.
    netstandard2.0 để nạp được trong cả net48 lẫn net8.0-windows.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DhcbTools.Shared.Hosting</RootNamespace>
    <AssemblyName>DhcbTools.Shared.Hosting</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DhcbTools.Shared.Logic\DhcbTools.Shared.Logic.csproj" />
  </ItemGroup>

</Project>
