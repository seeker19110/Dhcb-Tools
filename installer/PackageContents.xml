<?xml version="1.0" encoding="utf-8"?>
<!--
  Bundle tự nạp cho AutoCAD: đặt ở %APPDATA%\Autodesk\ApplicationPlugins\DhcbTools.bundle\
  thì AutoCAD nạp plugin khi khởi động, không cần NETLOAD thủ công mỗi phiên.
  SeriesMin/Max theo internal version: AutoCAD 2024 = R24.3, 2025 = R25.0.
  Version được installer thay bằng phiên bản thật lúc đóng gói (release.yml).
-->
<ApplicationPackage
    SchemaVersion="1.0"
    AppVersion="1.0.0"
    ProductCode="{B4E7C2A9-3D51-4F86-9A2C-7E0D5B1F8C44}"
    Name="DHCB Tools"
    Description="Tự động hoá AutoCAD cho kỹ sư xây dựng — layer, attribute, đánh số, kiểm chuẩn, HTTP Bridge."
    Author="DHCB"
    HelpFile="https://github.com/seeker19110/Dhcb-Tools"
    ProductType="Application">

  <CompanyDetails
      Name="DHCB"
      Url="https://github.com/seeker19110/Dhcb-Tools" />

  <Components Description="AutoCAD 2024">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.3" SeriesMax="R24.3" />
    <ComponentEntry
        AppName="DhcbTools.AutoCAD"
        ModuleName="./Contents/2024/DhcbTools.AutoCAD.dll"
        AppDescription="DHCB Tools cho AutoCAD 2024"
        LoadOnAutoCADStartup="True" />
  </Components>

  <Components Description="AutoCAD 2025">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" SeriesMax="R25.0" />
    <ComponentEntry
        AppName="DhcbTools.AutoCAD"
        ModuleName="./Contents/2025/DhcbTools.AutoCAD.dll"
        AppDescription="DHCB Tools cho AutoCAD 2025"
        LoadOnAutoCADStartup="True" />
  </Components>

</ApplicationPackage>
