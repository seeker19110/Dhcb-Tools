{
  "name": "DHCB deterministic AutoCAD engineering writes",
  "model": "Copied Autodesk sample with autocad-engineering.lsp fixture",
  "//": [
    "Run scripts/run-autocad-fixture-tests.ps1; fixture is created only in a sample copy.",
    "Exact exported attribute values are independently checked by the runner; DBText/MText final contents are checked via AutoLISP.",
    "No source drawing is saved. Every real write requires allowWrite and RunTests allowWrites."
  ],
  "cases": [
    {
      "name": "Attribute fixture baseline",
      "command": "AttributeExport",
      "config": {
        "blockName": "DHCB-QA-ENGINEERING",
        "outputPath": "{outputFolder}/attributes-baseline.csv"
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 6,
        "maxAffected": 6,
        "noErrors": true,
        "maxMs": 30000,
        "maxChangeEvents": 0,
        "filesExist": [
          "{outputFolder}/attributes-baseline.csv"
        ]
      }
    },
    {
      "name": "Text preview covers DBText, formatted MText and attribute",
      "command": "TextReplace",
      "config": {
        "find": "DHCB-QA-OLD",
        "replace": "DHCB-QA-NEW"
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 3,
        "maxAffected": 3,
        "noErrors": true,
        "maxMs": 30000,
        "maxChangeEvents": 0
      }
    },
    {
      "name": "Repeated text preview has no model changes",
      "command": "TextReplace",
      "config": {
        "find": "DHCB-QA-OLD",
        "replace": "DHCB-QA-NEW"
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 3,
        "maxAffected": 3,
        "noErrors": true,
        "maxMs": 30000,
        "maxChangeEvents": 0
      }
    },
    {
      "name": "Text replacement commits three entities",
      "command": "TextReplace",
      "config": {
        "find": "DHCB-QA-OLD",
        "replace": "DHCB-QA-NEW"
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 3,
        "maxAffected": 3,
        "noErrors": true,
        "maxMs": 30000,
        "summaryNotContains": [
          "Xem trước"
        ]
      },
      "allowWrite": true
    },
    {
      "name": "Repeated committed text replacement is a no-op",
      "command": "TextReplace",
      "config": {
        "find": "DHCB-QA-OLD",
        "replace": "DHCB-QA-NEW"
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 0,
        "maxAffected": 0,
        "noErrors": true,
        "maxMs": 30000,
        "summaryNotContains": [
          "Xem trước"
        ]
      },
      "allowWrite": true
    },
    {
      "name": "Text restoration preview sees committed values",
      "command": "TextReplace",
      "config": {
        "find": "DHCB-QA-NEW",
        "replace": "DHCB-QA-OLD"
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 3,
        "maxAffected": 3,
        "noErrors": true,
        "maxMs": 30000,
        "maxChangeEvents": 0
      }
    },
