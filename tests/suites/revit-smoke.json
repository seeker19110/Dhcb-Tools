          "ViewTemplates"
        ]
      },
      "expect": {
        "success": false,
        "summaryContains": [
          "file chuẩn"
        ],
        "maxMs": 60000
      }
    },
    {
      "name": "Báo lỗi rõ khi không có sheet nguồn",
      "command": "ViewportCopy",
      "config": {
        "sourceSheetNumber": "DHCB-KHONG-CO",
        "targetSheetContains": "A"
      },
      "expect": {
        "success": false,
        "summaryContains": [
          "sheet"
        ],
        "maxMs": 60000
      }
    },
    {
      "name": "Gán revision lên sheet",
      "command": "RevisionOnSheets",
      "config": {
        "revisionSequence": 1
      },
      "//": "Model mau co the khong co revision nao; ca nay chot 'khong nem, va neu khong co thi phai noi ro co nhung revision nao' chu khong chot success.",
      "expect": {
        "success": null,
        "maxMs": 60000,
        "neverContains": [
          "Exception"
        ]
      }
    },
    {
      "name": "Học từ điển tham số của dự án — xem trước, không đụng file thật",
      "command": "DictionaryLearn",
      "config": {
        "outputPath": "{outputFolder}/dictionary.json",
        "reportPath": "{outputFolder}/dictionary-suggest.csv",
        "dryRun": true
      },
      "//": "outputPath tro vao thu muc ket qua nen ca nay khong bao gio cham file dictionary.json that trong APPDATA cua nguoi dung. Khong chot minAffected: model mau dung thu vien tieng Anh chuan nen phan lon khoa roi vao 'da co', va do moi la ket qua dung.",
      "expect": {
        "success": true,
        "maxMs": 60000,
        "summaryContains": [
          "Xem trước"
        ],
        "neverContains": [
          "Exception"
        ],
        "filesExist": [
          "{outputFolder}/dictionary-suggest.csv"
        ]
      }
    },
    {
      "name": "Số liệu sử dụng — đọc lại log thật của máy này",
      "command": "UsageReport",
      "config": {
        "outputPath": "{outputFolder}/usage.md",
        "csvPath": "{outputFolder}/usage.csv"
      },
      "//": "Doc thu muc log that trong APPDATA (chi doc, khong ghi). success:null vi may chua cai add-in bao gio thi chua co log — do la moi truong, khong phai loi ma. Cai duoc chot o day la lenh khong nem va noi ro 'chua co so lieu' khac 'khong ai dung lenh nao'.",
      "expect": {
        "success": null,
        "maxMs": 30000,
        "neverContains": [
          "Exception"
        ]
      }
    },
    {
      "name": "Toạ độ định vị — tim cột + giao trục ra CSV/DXF cho máy toàn đạc",
      "command": "SetoutExport",
      "config": {
        "categories": [
          "Structural Columns",
          "Columns"
        ],
        "includeGridIntersections": true,
        "outputPath": "{outputFolder}/setout.csv",
        "dxfPath": "{outputFolder}/setout.dxf"
      },
      "//": "De xuat A1 (nghien-cuu-chuoi-den-hoan-cong.md). Chi doc, khong transaction. Model kien truc chac chan co truc nen ca nay thanh cong ke ca khi khong co cot; minAffected chot 'khong no-op'. Thong bao phai noi ro goc Survey (E/N/Z, goc True North) de tro trac dac doi chieu.",
      "expect": {
        "success": true,
        "minAffected": 1,
        "maxMs": 60000,
        "messagesContain": [
          "True North"
        ],
        "filesExist": [
          "{outputFolder}/setout.csv",
          "{outputFolder}/setout.dxf"
        ]
      }
    },
    {
      "name": "Toạ độ định vị — báo lỗi rõ khi thứ tự cột có chữ máy không hiểu",
      "command": "SetoutExport",
      "config": {
        "columns": "PNEQ",
        "outputPath": "{outputFolder}/setout-sai.csv"
      },
      "//": "Sai mot chu cot la bao ro, khong doan. Duong loi phai duoc chot nhu duong thanh cong.",
      "expect": {
        "success": false,
        "maxMs": 10000,
        "summaryContains": [
          "không hợp lệ"
        ],
        "neverContains": [
          "Exception"
        ]
      }
