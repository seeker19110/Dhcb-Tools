      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 1,
        "maxAffected": 1,
        "maxChangeEvents": 0,
        "noErrors": true,
        "messagesContain": [
          "Layer \"4\": 3 thuộc tính đổi"
        ],
        "neverContains": [
          "hiện hành"
        ]
      }
    },
    {
