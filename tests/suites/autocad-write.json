          {
            "op": "arc",
            "center": [
              0,
              0
            ],
            "radius": 800,
            "startAngle": 0,
            "endAngle": 90,
            "layer": "KL-TEST-VE"
          },
          {
            "op": "ellipse",
            "center": [
              -3000,
              2000
            ],
            "majorAxis": [
              1000,
              0
            ],
            "ratio": 0.4,
            "layer": "KL-TEST-VE"
          },
          {
            "op": "mtext",
            "position": [
              0,
