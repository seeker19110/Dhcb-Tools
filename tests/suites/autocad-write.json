{
  "name": "DHCB — đường ghi thật trong AutoCAD",
  "model": "Data Extraction and Multileaders Sample.dwg",
  "//": [
    "Bộ DUY NHẤT có ca ghi thật vào bản vẽ. Ba lớp bảo vệ như bên Revit:",
    "  1. ca phải khai báo \"allowWrite\": true;",
    "  2. người chạy phải bật allowWrites (scripts/run-in-autocad-tests.ps1 -AllowWrites);",
    "  3. script chép bản vẽ mẫu sang thư mục kết quả và chạy trên BẢN CHÉP.",
    "",
    "Chuỗi tự chứng minh và tự khôi phục: xuất layer gốc → nhập fixture đổi đúng một ô (ghi thật) →",
    "nhập lại fixture đó phải ra 0 → nhập lại CSV gốc để trả layer về như cũ.",
    "Con số 0 ở bước ba là bằng chứng bước hai ĐÃ GHI THẬT."
  ],
  "cases": [
    {
      "name": "Xuất layer — bản gốc để khôi phục",
      "command": "LayerExport",
      "config": {
        "outputPath": "{outputFolder}/layers-goc.csv"
      },
      "expect": {
        "success": true,
        "minAffected": 1,
        "maxMs": 30000,
        "filesExist": [
          "{outputFolder}/layers-goc.csv"
        ]
      }
    },
    {
      "name": "Nhập layer có thay đổi — xem trước không phát sự kiện ghi tạm",
      "command": "LayerImport",
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-doi-mot-o.csv"
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 1,
        "maxAffected": 1,
        "maxChangeEvents": 0,
        "noErrors": true
      }
    },
    {
      "name": "Nhập CSV đổi đúng một ô — GHI THẬT",
      "command": "LayerImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-doi-mot-o.csv"
      },
      "expect": {
        "success": true,
        "minAffected": 1,
        "maxAffected": 1,
        "summaryContains": [
          "Đã nhập"
        ],
        "summaryNotContains": [
          "Xem trước"
        ],
        "maxMs": 30000
      }
    },
    {
      "name": "Nhập lại chính fixture đó — phải không còn gì để đổi",
      "command": "LayerImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-doi-mot-o.csv"
      },
      "//": "0 o doi = bang chung ca truoc DA GHI THAT vao drawing, khong phai rollback.",
      "expect": {
        "success": true,
        "maxAffected": 0,
        "messagesContain": [
          "giữ nguyên"
        ],
        "summaryNotContains": [
          "Xem trước"
        ],
        "maxMs": 30000
      }
    },
    {
      "name": "Nhập lại CSV gốc — GHI THẬT, trả layer về như cũ",
      "command": "LayerImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{outputFolder}/layers-goc.csv"
      },
      "expect": {
        "success": true,
        "minAffected": 1,
        "maxAffected": 1,
        "summaryNotContains": [
          "Xem trước"
        ],
        "maxMs": 30000
      }
    },
    {
      "name": "Kiểm lại lần cuối — bản vẽ đã về trạng thái gốc",
      "command": "LayerImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{outputFolder}/layers-goc.csv"
      },
      "expect": {
        "success": true,
        "maxAffected": 0,
        "summaryNotContains": [
          "Xem trước"
        ],
        "maxMs": 30000
      }
    },
    {
      "name": "Đóng băng layer hiện hành — AutoCAD cấm, phải nói ra và không ghi",
      "//": "Layer 2 la CLAYER cua ban ve mau.",
      "command": "LayerImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-dong-bang-layer-hien-hanh.csv"
      },
      "expect": {
        "success": true,
        "maxAffected": 0,
        "noErrors": true,
        "messagesContain": [
          "Layer \"2\" đang là layer hiện hành"
        ],
        "summaryNotContains": [
          "Xem trước"
        ]
      }
    },
    {
      "name": "Đóng băng + tắt + khoá một layer — xem trước không phát sự kiện ghi tạm",
      "command": "LayerImport",
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-dong-bang.csv"
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 1,
        "maxAffected": 1,
        "maxChangeEvents": 0,
        "noErrors": true,
        "messagesContain": [
          "Layer \"4\": 3 thuộc tính đổi"
        ],
        "neverContains": [
          "hiện hành"
        ]
      }
    },
    {
      "name": "Đóng băng + tắt + khoá một layer — GHI THẬT",
      "command": "LayerImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-dong-bang.csv"
      },
      "expect": {
        "success": true,
        "minAffected": 1,
        "maxAffected": 1,
        "summaryContains": [
          "Đã nhập"
        ],
        "summaryNotContains": [
          "Xem trước"
        ],
        "noErrors": true
      }
    },
    {
      "name": "Nhập lại CSV đóng băng — phải ra 0 (bằng chứng đã ghi thật)",
      "command": "LayerImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-dong-bang.csv"
      },
      "expect": {
        "success": true,
        "maxAffected": 0,
        "messagesContain": [
          "giữ nguyên"
        ],
        "summaryNotContains": [
          "Xem trước"
        ]
      }
    },
    {
      "name": "Rã băng bằng CSV gốc (có cột IsFrozen/IsOff/IsLocked)",
      "command": "LayerImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{outputFolder}/layers-goc.csv"
      },
      "expect": {
        "success": true,
        "minAffected": 1,
        "maxAffected": 1,
        "summaryNotContains": [
          "Xem trước"
        ],
        "maxMs": 30000
      }
    },
    {
      "name": "Kiểm lại sau đóng băng — bản vẽ đã về trạng thái gốc",
      "command": "LayerImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{outputFolder}/layers-goc.csv"
      },
      "expect": {
        "success": true,
        "maxAffected": 0,
        "summaryNotContains": [
          "Xem trước"
        ],
        "maxMs": 30000
      }
    },
    {
      "name": "Dòng trùng giống nhau — xem trước tạo đúng một layer",
      "command": "LayerImport",
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-duplicate-same.csv",
        "createMissing": true
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 1,
        "maxAffected": 1,
        "maxMs": 30000,
        "maxChangeEvents": 0,
        "noErrors": true
      }
    },
    {
      "name": "Dòng trùng giống nhau — ghi thật tạo đúng một layer",
      "command": "LayerImport",
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-duplicate-same.csv",
        "createMissing": true
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 1,
        "maxAffected": 1,
        "maxMs": 30000,
        "noErrors": true,
        "summaryNotContains": [
          "Xem trước"
        ]
      },
      "allowWrite": true
    },
    {
      "name": "Nhập lại layer mới — không còn gì để đổi",
      "command": "LayerImport",
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-duplicate-same.csv",
        "createMissing": true
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 0,
        "maxAffected": 0,
        "maxMs": 30000,
        "noErrors": true,
        "summaryNotContains": [
          "Xem trước"
        ]
      },
      "allowWrite": true
    },
    {
      "name": "Dòng trùng xung đột — xem trước không ghi",
      "command": "LayerImport",
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-duplicate-conflict.csv",
        "createMissing": true
      },
      "expect": {
        "success": true,
        "partialSuccess": true,
        "minAffected": 0,
        "maxAffected": 0,
        "maxMs": 30000,
        "maxChangeEvents": 0
      }
    },
    {
      "name": "Dòng trùng xung đột — ghi thật cũng giữ nguyên",
      "command": "LayerImport",
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-duplicate-conflict.csv",
        "createMissing": true
      },
      "expect": {
        "success": true,
        "partialSuccess": true,
        "minAffected": 0,
        "maxAffected": 0,
        "maxMs": 30000,
        "summaryNotContains": [
          "Xem trước"
        ]
      },
      "allowWrite": true
    },
    {
      "name": "Sau xung đột — layer vẫn giữ giá trị đã duyệt",
      "command": "LayerImport",
      "config": {
        "inputPath": "{suiteFolder}/fixtures/layers-duplicate-same.csv",
        "createMissing": true
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 0,
        "maxAffected": 0,
        "maxMs": 30000,
        "noErrors": true,
        "summaryNotContains": [
          "Xem trước"
        ]
      },
      "allowWrite": true
    },
    {
      "name": "Gộp DWG ghi thật — block + layout của file nguồn",
      "command": "DrawingCombine",
      "config": {
        "inputPaths": [
          "{suiteFolder}/fixtures/tuyen-ong.dwg"
        ],
        "gapMm": 5000,
        "dryRun": false
      },
      "//": "Chay tren ban chep. Block tuyen-ong chua co trong ban mau nen phai gop du 1/1.",
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 1,
        "maxMs": 120000,
        "noErrors": true,
        "summaryContains": [
          "Đã gộp 1/1 bản vẽ"
        ],
        "summaryNotContains": [
          "Xem trước"
        ]
      },
      "allowWrite": true
    },
    {
      "name": "Chuyển entity theo handle — xem trước: 3 entity, handle thiếu được báo",
      "command": "EntityLayerAssign",
      "//": "1EBA/1EBB la Line layer 4MDUCT trong Model, 1F21 la TEXT layer 2 trong layout cua ban ve mau; FFFFFF khong ton tai.",
      "config": {
        "mapCsvPath": "{suiteFolder}/fixtures/entity-layer-tach-he.csv"
      },
      "expect": {
        "success": true,
        "partialSuccess": true,
        "minAffected": 3,
        "maxAffected": 3,
        "maxChangeEvents": 0,
        "messagesContain": [
          "Sẽ tạo layer mới: \"KL-TEST-ONG\" (màu 3)",
          "1 handle không có trong bản vẽ"
        ]
      }
    },
    {
      "name": "Chuyển entity theo handle — GHI THẬT",
      "command": "EntityLayerAssign",
      "allowWrite": true,
      "config": {
        "mapCsvPath": "{suiteFolder}/fixtures/entity-layer-tach-he.csv"
      },
      "expect": {
        "success": true,
        "minAffected": 3,
        "maxAffected": 3,
        "summaryContains": [
          "Đã chuyển 3 entity"
        ],
        "messagesContain": [
          "→ \"KL-TEST-ONG\": 2 entity"
        ],
        "summaryNotContains": [
          "Xem trước"
        ]
      }
    },
    {
      "name": "Chạy lại — 0 entity đổi (bằng chứng đã ghi thật)",
      "command": "EntityLayerAssign",
      "allowWrite": true,
      "config": {
        "mapCsvPath": "{suiteFolder}/fixtures/entity-layer-tach-he.csv"
      },
      "expect": {
        "success": true,
        "maxAffected": 0,
        "messagesContain": [
          "3 entity đã ở đúng layer đích"
        ],
        "summaryNotContains": [
          "Xem trước"
        ]
      }
    },
    {
      "name": "Trả entity về layer gốc",
      "command": "EntityLayerAssign",
      "allowWrite": true,
      "config": {
        "mapCsvPath": "{suiteFolder}/fixtures/entity-layer-tra-ve.csv",
        "createMissingLayers": false
      },
      "expect": {
        "success": true,
        "partialSuccess": false,
        "minAffected": 3,
        "maxAffected": 3,
        "noErrors": true,
        "summaryNotContains": [
          "Xem trước"
        ]
      }
    },
    {
      "name": "Vẽ polyline từ CSV — xem trước: 2 polyline, dòng 1 đỉnh bị báo",
      "command": "PolylineImport",
      "config": {
        "inputPath": "{suiteFolder}/fixtures/polyline-import.csv"
      },
      "expect": {
        "success": true,
        "partialSuccess": true,
        "minAffected": 2,
        "maxAffected": 2,
        "maxChangeEvents": 0,
        "messagesContain": [
          "Sẽ tạo layer mới: \"KL-TEST-PL\" (màu 4)",
          "2 polyline, tổng dài 7341.421",
          "ít nhất 2 đỉnh"
        ]
      }
    },
    {
      "name": "Vẽ polyline từ CSV — GHI THẬT",
      "command": "PolylineImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{suiteFolder}/fixtures/polyline-import.csv"
      },
      "expect": {
        "success": true,
        "minAffected": 2,
        "maxAffected": 2,
        "summaryContains": [
          "Đã vẽ 2 polyline"
        ],
        "summaryNotContains": [
          "Xem trước"
        ]
      }
    },
    {
      "name": "Vẽ lại với replaceExisting — xoá 2 cũ, vẽ 2 mới (không chồng)",
      "command": "PolylineImport",
      "allowWrite": true,
      "config": {
        "inputPath": "{suiteFolder}/fixtures/polyline-import.csv",
        "replaceExisting": true
      },
      "expect": {
        "success": true,
        "minAffected": 4,
        "maxAffected": 4,
        "messagesContain": [
          "Đã xoá 2 polyline cũ"
        ],
        "summaryNotContains": [
          "Xem trước"
        ]
      }
    }
  ]
}
