<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bộ test cho ĐƯỜNG CLI của BatchRunner — thứ mà cổng phủ 100% dòng của Shared.Logic không với tới.
    §44 (vai kỹ sư test) cho thấy cả hai lỗi làm sập runner đều nằm ở đây và đều là "đầu vào hỏng":
    tầng thuần chỉ nhận chuỗi nên test thuần không bao giờ đưa một file rác vào. Bộ này gọi thẳng
    Program.Main với đúng tham số dòng lệnh, nên nó bắt được đường đi thật, kể cả ngoại lệ chưa bắt
    (trước đây thoát 127) chứ không chỉ hàm tầng dưới.

    net10.0 thuần như BatchRunner: chạy được trên CI Linux, không cần Revit/AutoCAD.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DhcbTools.BatchRunner\DhcbTools.BatchRunner.csproj" />
  </ItemGroup>

</Project>
