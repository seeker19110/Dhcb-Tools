<Project>

  <!--
    Multi-target cho nhiều phiên bản Revit trong cùng solution.
    Quy ước: mỗi build cấu hình (Debug/Release) x (R21..R25) tương ứng một TargetFramework.
    RevitVersion truyền vào qua biến môi trường hoặc -p:RevitVersion=2024 khi build.
  -->
  <!--
    RevitVersion phải có mặc định: PackageReference của Core dùng Version="$(RevitVersion).*", nên khi
    biến rỗng thì chuỗi phiên bản thành ".*" — NuGet trả về false mà KHÔNG log lỗi nào, và `dotnet build`
    trần chỉ báo "error MSB4181: The RestoreTask task returned false but did not log an error". Mặc định
    2024 trùng đúng nhánh TFM cũ dành cho biến rỗng (net48), nên không đổi kết quả build nào đang có.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)'==''">2024</RevitVersion>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Trước đây GenerateAssemblyInfo=false mà không có AssemblyInfo.cs nào trong repo, nên mọi DLL phát hành
      đều mang phiên bản 0.0.0.0 — GET /health không cho biết đang chạy bản build nào (lỗi phát hiện ở R4).
      Nay sinh attribute phiên bản từ property Version; release.yml truyền -p:Version=<tag> vào mọi dotnet build.
    -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version Condition="'$(Version)'==''">0.9.0-dev</Version>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Company>DHCB</Company>
    <Product>DHCB Revit Tools</Product>
    <Copyright>Copyright (c) DHCB</Copyright>
  </PropertyGroup>

  <!--
    Chọn TargetFramework theo ĐÚNG phần mềm chủ của từng project.
    Trước đây TFM chỉ nhìn RevitVersion, nên vỏ AutoCAD luôn ra net48 kể cả khi build cho
    AutoCAD 2025/2026 — mà AutoCAD 2025 chạy .NET 8 và AutoCAD 2026 chạy .NET 10, nên DLL net48
    không NETLOAD được. Project AutoCAD nay theo AcadVersion, còn lại theo RevitVersion.
  -->
  <PropertyGroup>
    <DhcbIsAcadProject Condition="$(MSBuildProjectName.Contains('AutoCAD'))">true</DhcbIsAcadProject>
  </PropertyGroup>

  <!-- Vỏ/Core AutoCAD: ≤2024 → net48 (.NET Framework), 2025 → .NET 8, 2026+ → .NET 10. -->
  <PropertyGroup Condition="'$(DhcbIsAcadProject)'=='true'">
    <TargetFramework Condition="'$(AcadVersion)'=='' Or $(AcadVersion) &lt;= 2024">net48</TargetFramework>
    <TargetFramework Condition="'$(AcadVersion)' != '' And $(AcadVersion) == 2025">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AcadVersion)' != '' And $(AcadVersion) &gt;= 2026">net10.0-windows</TargetFramework>
  </PropertyGroup>

  <!-- Revit 2021-2024 chạy trên .NET Framework 4.8; Revit 2025+ chạy trên .NET 8. -->
  <PropertyGroup Condition="'$(DhcbIsAcadProject)' != 'true'">
    <TargetFramework Condition="'$(RevitVersion)'=='' Or $(RevitVersion) &lt; 2025">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' != '' And $(RevitVersion) &gt;= 2025">net8.0-windows</TargetFramework>
  </PropertyGroup>

  <!-- Hằng biên dịch theo phiên bản: CreateContainsRule bỏ tham số caseSensitive từ 2023. -->
  <PropertyGroup Condition="'$(RevitVersion)' != '' And $(RevitVersion) &gt;= 2023">
    <DefineConstants>$(DefineConstants);REVIT2023_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Hằng biên dịch theo phiên bản: ElementId.Value (long) thay IntegerValue từ 2024. -->
  <PropertyGroup Condition="'$(RevitVersion)' != '' And $(RevitVersion) &gt;= 2024">
    <DefineConstants>$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!--
    Build kiểm tra trên Linux/CI (không có WindowsDesktop SDK): dotnet build -p:EnableWindowsTargeting=true -p:UseWPF=false
    → vỏ Revit bỏ thư mục UI (WPF) ra khỏi compile; xem scripts/check-build.sh.
  -->
  <PropertyGroup Condition="'$(UseWPF)'=='false'">
    <DhcbSkipWpf>true</DhcbSkipWpf>
    <DefineConstants>$(DefineConstants);DHCB_SKIP_WPF</DefineConstants>
  </PropertyGroup>

  <!--
    AutoCAD: đường dẫn tới thư mục cài AutoCAD, dùng cho HintPath của AcMgd/AcDbMgd/AcCoreMgd.
    Truyền vào khi build:  dotnet build -p:AcadVersion=2024
    Hoặc đặt biến môi trường AcadRoot trỏ thẳng đến thư mục cài đặt.
    AutoCAD 2024 trở về trước: net48 | AutoCAD 2025+: net8.0-windows (tương tự Revit).
  -->
  <PropertyGroup>
    <AcadVersion Condition="'$(AcadVersion)'==''">2024</AcadVersion>
    <AcadRoot Condition="'$(AcadRoot)'==''">$(ProgramFiles)\Autodesk\AutoCAD $(AcadVersion)</AcadRoot>
    <!--
      Phiên bản package AutoCAD.NET.Core/.Model theo năm: ≤2024 → 24.* (net48), 2025 → 25.0.* (net8),
      2026+ → 25.1.* (AutoCAD 2026.1 đã chuyển sang .NET 10 — xem mục giới hạn công nghệ trong docs).
    -->
    <AcadNetVersion Condition="'$(AcadNetVersion)'=='' And $(AcadVersion) &lt;= 2024">24.*</AcadNetVersion>
    <AcadNetVersion Condition="'$(AcadNetVersion)'=='' And $(AcadVersion) == 2025">25.0.*</AcadNetVersion>
    <AcadNetVersion Condition="'$(AcadNetVersion)'==''">25.1.*</AcadNetVersion>
  </PropertyGroup>


  <!--
    Reference assemblies cho net48: cho phép build nhánh Revit/AutoCAD ≤ 2024 trên máy
    không cài .NET Framework (CI Linux). Trên Windows có sẵn SDK thì package này vô hại.
  -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
