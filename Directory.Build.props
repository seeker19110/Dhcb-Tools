<Project>
  <!-- Each host year uses its own SDK. Older AutoCAD hosts cannot load a newer SDK. -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)'==''">2024</RevitVersion>
    <AcadVersion Condition="'$(AcadVersion)'==''">2024</AcadVersion>
    <DhcbIsAcadProject Condition="$(MSBuildProjectName.Contains('AutoCAD'))">true</DhcbIsAcadProject>
    <DhcbIsRevitProject Condition="'$(MSBuildProjectName)'=='DhcbTools.Core' Or '$(MSBuildProjectName)'=='DhcbTools.Revit'">true</DhcbIsRevitProject>
    <AcadRuntime Condition="'$(AcadRuntime)'=='' And ('$(AcadVersion)'=='2022' Or '$(AcadVersion)'=='2023' Or '$(AcadVersion)'=='2024')">net48</AcadRuntime>
    <AcadRuntime Condition="'$(AcadRuntime)'=='' And '$(AcadVersion)'=='2025'">net8</AcadRuntime>
    <!-- Preserve the existing 2026 package default; RTM hosts select AcadRuntime=net8. -->
    <AcadRuntime Condition="'$(AcadRuntime)'=='' And ('$(AcadVersion)'=='2026' Or '$(AcadVersion)'=='2027')">net10</AcadRuntime>
    <RevitRuntime Condition="'$(RevitVersion)'=='2022' Or '$(RevitVersion)'=='2023' Or '$(RevitVersion)'=='2024'">net48</RevitRuntime>
    <!-- The .NET 8 API baseline also serves updated 2025.5/2026.5 hosts; host smoke tests are required. -->
    <RevitRuntime Condition="'$(RevitVersion)'=='2025' Or '$(RevitVersion)'=='2026'">net8</RevitRuntime>
    <RevitRuntime Condition="'$(RevitVersion)'=='2027'">net10</RevitRuntime>
    <RevitApiVersion Condition="'$(RevitApiVersion)'=='' And '$(RevitVersion)'=='2022'">2022.1.80</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitApiVersion)'=='' And '$(RevitVersion)'=='2023'">2023.1.90</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitApiVersion)'=='' And '$(RevitVersion)'=='2024'">2024.3.60</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitApiVersion)'=='' And '$(RevitVersion)'=='2025'">2025.4.60</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitApiVersion)'=='' And '$(RevitVersion)'=='2026'">2026.4.10</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitApiVersion)'=='' And '$(RevitVersion)'=='2027'">2027.2.0</RevitApiVersion>
    <AcadNetVersion Condition="'$(AcadNetVersion)'=='' And '$(AcadVersion)'=='2022'">24.1.51000</AcadNetVersion>
    <AcadNetVersion Condition="'$(AcadNetVersion)'=='' And '$(AcadVersion)'=='2023'">24.2.0</AcadNetVersion>
    <AcadNetVersion Condition="'$(AcadNetVersion)'=='' And '$(AcadVersion)'=='2024'">24.3.0</AcadNetVersion>
    <AcadNetVersion Condition="'$(AcadNetVersion)'=='' And '$(AcadVersion)'=='2025' And '$(AcadRuntime)'=='net8'">25.0.1</AcadNetVersion>
    <AcadNetVersion Condition="'$(AcadNetVersion)'=='' And '$(AcadVersion)'=='2025' And '$(AcadRuntime)'=='net10'">25.0.2</AcadNetVersion>
    <AcadNetVersion Condition="'$(AcadNetVersion)'=='' And '$(AcadVersion)'=='2026' And '$(AcadRuntime)'=='net8'">25.1.0</AcadNetVersion>
    <AcadNetVersion Condition="'$(AcadNetVersion)'=='' And '$(AcadVersion)'=='2026' And '$(AcadRuntime)'=='net10'">25.1.1</AcadNetVersion>
    <AcadNetVersion Condition="'$(AcadNetVersion)'=='' And '$(AcadVersion)'=='2027'">26.0.0</AcadNetVersion>
    <AcadCoreNetVersion Condition="'$(AcadCoreNetVersion)'=='' And '$(AcadNetVersion)'=='25.0.1'">25.0.0</AcadCoreNetVersion>
    <AcadCoreNetVersion Condition="'$(AcadCoreNetVersion)'==''">$(AcadNetVersion)</AcadCoreNetVersion>
    <AcadRoot Condition="'$(AcadRoot)'==''">$(ProgramFiles)\Autodesk\AutoCAD $(AcadVersion)</AcadRoot>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version Condition="'$(Version)'==''">0.9.0-dev</Version>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Company>DHCB</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Product>DHCB Tools</Product>
    <Copyright>Copyright (c) DHCB</Copyright>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DhcbIsAcadProject)'=='true'">
    <TargetFramework Condition="'$(AcadRuntime)'=='net48'">net48</TargetFramework>
    <TargetFramework Condition="'$(AcadRuntime)'=='net8'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AcadRuntime)'=='net10'">net10.0-windows</TargetFramework>
    <DhcbHostBuildPath>$(AcadVersion)/$(AcadRuntime)</DhcbHostBuildPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DhcbIsRevitProject)'=='true'">
    <TargetFramework Condition="'$(RevitRuntime)'=='net48'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitRuntime)'=='net8'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitRuntime)'=='net10'">net10.0-windows</TargetFramework>
    <DhcbHostBuildPath>$(RevitVersion)/$(RevitRuntime)</DhcbHostBuildPath>
  </PropertyGroup>
  <!-- A headless validation build must not replace DLLs needed by the WPF host or SkipBuild. -->
  <PropertyGroup Condition="'$(DhcbHostBuildPath)'!='' And '$(UseWPF)'=='false'">
    <DhcbHostBuildPath>$(DhcbHostBuildPath)/headless</DhcbHostBuildPath>
  </PropertyGroup>
  <!-- Isolate restore assets AND assemblies when compiling several SDK baselines in one checkout. -->
  <PropertyGroup Condition="'$(DhcbHostBuildPath)'!=''">
    <BaseOutputPath>bin/$(DhcbHostBuildPath)/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/$(DhcbHostBuildPath)/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DhcbIsRevitProject)'=='true' And ('$(RevitVersion)'=='2023' Or '$(RevitVersion)'=='2024' Or '$(RevitVersion)'=='2025' Or '$(RevitVersion)'=='2026' Or '$(RevitVersion)'=='2027')">
    <DefineConstants>$(DefineConstants);REVIT2023_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DhcbIsRevitProject)'=='true' And ('$(RevitVersion)'=='2024' Or '$(RevitVersion)'=='2025' Or '$(RevitVersion)'=='2026' Or '$(RevitVersion)'=='2027')">
    <DefineConstants>$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseWPF)'=='false'">
    <DhcbSkipWpf>true</DhcbSkipWpf>
    <DefineConstants>$(DefineConstants);DHCB_SKIP_WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
