{
  "rules": [
    { "category": "Layer", "parameter": "Name",      "required": true, "pattern": "^(0|Defpoints|[A-Z]{1,2}-[A-Z0-9]{2,6}(-[A-Z0-9]{2,6})*)$", "description": "Chuẩn AIA: A-WALL, S-COLS-GRID…" },
    { "category": "Layer", "parameter": "Color",     "required": true, "pattern": "^\\d{1,3}$", "description": "Màu theo chỉ số ACI, không dùng TrueColor" },
    { "category": "Layer", "parameter": "Plottable", "required": true, "allowedValues": ["true", "false"] },
    { "category": "Layer", "parameter": "Linetype",  "required": true, "allowedValues": ["Continuous", "HIDDEN", "CENTER", "DASHED", "PHANTOM"], "severity": "warning" }
  ]
}
